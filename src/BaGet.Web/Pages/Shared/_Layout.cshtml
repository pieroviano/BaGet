@inject Microsoft.Extensions.Options.IOptions<BaGet.Core.AccountsOptions> Accounts
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BaGet">
    <meta name="author" content="Loic Sharma">

    <link rel="shortcut icon" href="~/_content/BaGet.Web/favicon.ico">

    <link rel="stylesheet" href="~/_content/BaGet.Web/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/BaGet.Web/lib/office-ui-fabric-core/dist/css/fabric.min.css" />
    <link rel="stylesheet" href="~/_content/BaGet.Web/css/site.css" />

    <title>@ViewData["Title"] - BaGet</title>
</head>
<body>
    <header>

        <nav class="navbar navbar-inverse" role="navigation">
            <div class="container">
                <div class="row">
                    <div id="navbar" class="col-sm-12">
                        <ul class="nav navbar-nav" role="tablist">
                            <li role="presentation"><a href="/packages" role="tab" nav-link><span>Packages</span></a></li>
                            <li role="presentation"><a asp-area="" asp-page="/Upload" role="tab" nav-link><span>Upload</span></a></li>
                            <li role="presentation"><a asp-area="" asp-page="/Statistics" role="tab" nav-link><span>Statistics</span></a></li>
                            <li role="presentation">
                                <a role="tab" href="https://loic-sharma.github.io/BaGet/" target="_blank" rel="noopener noreferrer">
                                    <span>Documentation</span>
                                </a>
                            </li>
                        </ul>
                        @if (Accounts.Value.Enabled)
                        {
                            <ul class="nav navbar-nav navbar-right" role="tablist">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li role="presentation" class="dropdown account-menu">
                                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                            <span>@User.Identity.Name</span> <span class="caret"></span>
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li><a href="@Url.Page("/Account/Profile")">Profile</a></li>
                                            <li><a href="@Url.Page("/Account/Settings")">Account settings</a></li>
                                            <li><a href="@Url.Page("/Account/ApiKeys")">API keys</a></li>
                                            <li><a href="@Url.Page("/Account/Packages")">My packages</a></li>
                                            <li><a href="@Url.Page("/Account/Organizations")">Organizations</a></li>
                                            <li><a href="@Url.Page("/Upload")">Upload package</a></li>
                                            <li role="separator" class="divider"></li>
                                            <li><a href="@Url.Page("/Account/Logout")">Sign out</a></li>
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li role="presentation"><a href="@Url.Page("/Account/Login")" role="tab"><span>Sign in</span></a></li>
                                    @if (Accounts.Value.AllowRegistration)
                                    {
                                        <li role="presentation"><a href="@Url.Page("/Account/Register")" role="tab"><span>Register</span></a></li>
                                    }
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="container search-container">
                <div class="row">
                    <form class="col-sm-12" action="@Url.Page("/Index")" method="get">
                        <div class="input-group">
                            <input type="text"
                                   name="q"
                                   value="@ViewData["SearchQuery"]"
                                   class="form-control"
                                   autoComplete="off"
                                   placeholder="Search packages..." />

                            <span class="input-group-btn">
                                <button type="submit"
                                        class="btn btn-default"
                                        title="Search for packages">
                                    <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
                                </button>
                            </span>
                        </div>

                        @await RenderSectionAsync("SearchForm", required: false)
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <section role="main" class="container main-container">
        @RenderBody()
    </section>

    <script src="~/_content/BaGet.Web/lib/alpinejs/dist/alpine.js"></script>

    <script src="~/_content/BaGet.Web/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/BaGet.Web/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/_content/BaGet.Web/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
