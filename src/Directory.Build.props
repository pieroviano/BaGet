<Project>

  <!-- Package properties -->
  <PropertyGroup>
    <Authors>Piero Viano</Authors>
    <Copyright>Copyright (c) Piero Viano 2026</Copyright>
    <Product>BaGet Extension</Product>
    <PackageIcon>packageIcon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Version>1.0.0.$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</Version>
    <PackageVersion>1.0.0.$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</PackageVersion>
    <PackageProjectUrl>https://pieroviano.github.io/BaGet/</PackageProjectUrl>
  </PropertyGroup>

  <!-- Compiler properties -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>

    <!-- Don't warn if there are missing XMl comment for publicly visible type or member-->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Debugging properties -->
  <PropertyGroup>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- NuGet dependencies shared across projects -->
  <PropertyGroup>
    <MicrosoftAspNetCorePackageVersion>10.0.13</MicrosoftAspNetCorePackageVersion>

    <!--
      Entity Framework is held at 9.x because Pomelo.EntityFrameworkCore.MySql has no release
      that supports Entity Framework 10: its latest, 9.0.0, constrains
      Microsoft.EntityFrameworkCore.Relational to [9.0.0, 9.0.999]. Every provider must move
      together, so each one reads its version from here rather than pinning its own.
    -->
    <MicrosoftEntityFrameworkCorePackageVersion>9.0.21</MicrosoftEntityFrameworkCorePackageVersion>
    <!-- Identity's EF stores depend on EF Core, so this tracks the EF version, not ASP.NET Core's. -->
    <MicrosoftAspNetCoreIdentityEntityFrameworkCorePackageVersion>9.0.21</MicrosoftAspNetCoreIdentityEntityFrameworkCorePackageVersion>
    <NpgsqlEntityFrameworkCorePackageVersion>9.0.4</NpgsqlEntityFrameworkCorePackageVersion>
    <PomeloEntityFrameworkCorePackageVersion>9.0.0</PomeloEntityFrameworkCorePackageVersion>

    <!--
      Entity Framework 9.0.21 depends on Microsoft.Extensions.* 9.0.21, so holding these at
      8.0.0 is a package downgrade (NU1605) and will not restore.
    -->
    <MicrosoftExtensionsPackageVersion>9.0.21</MicrosoftExtensionsPackageVersion>
    <NuGetPackageVersion>6.10.0</NuGetPackageVersion>
    <!-- SMTP client for BaGet.Identity's email sender; MIT. -->
    <MailKitPackageVersion>4.18.1</MailKitPackageVersion>
    <!-- Renders the two-factor setup QR code as SVG on the server; MIT. -->
    <QRCoderPackageVersion>1.6.0</QRCoderPackageVersion>
    <!-- Logging of the host (src/BaGet) only; libraries log through Microsoft.Extensions.Logging. -->
    <SerilogAspNetCorePackageVersion>10.0.0</SerilogAspNetCorePackageVersion>
    <SerilogSettingsConfigurationPackageVersion>10.0.1</SerilogSettingsConfigurationPackageVersion>
    <SerilogSinksConsolePackageVersion>6.1.1</SerilogSinksConsolePackageVersion>
    <SerilogSinksFilePackageVersion>7.0.0</SerilogSinksFilePackageVersion>
    <SerilogSinksEventLogPackageVersion>4.0.0</SerilogSinksEventLogPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == ''">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../packageIcon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../Acknowledgments.md" Pack="true" PackagePath="" Visible="false" />
    <!-- Each project's README.md is its package's readme on nuget.org. -->
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>Extension.$(MSBuildProjectName)</PackageId>
    <!--
      A Razor class library serves its wwwroot under "_content/<PackageId>" by default, so the
      package name would leak into every asset URL the pages reference. Pin the path to the
      project name, so it stays the same however the projects are packaged.
    -->
    <StaticWebAssetBasePath>_content/$(MSBuildProjectName)</StaticWebAssetBasePath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPublishable>False</IsPublishable>
    <PackageOutputPath>$(SolutionDir)Packages\</PackageOutputPath>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Target Name="DeleteOldPackage" AfterTargets="Pack" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <Exec Command="if exist %userprofile%\.nuget\Packages\$(MSBuildProjectName) rmdir /s /q %userprofile%\.nuget\Packages\Extension.$(MSBuildProjectName)" />
  </Target>

</Project>
