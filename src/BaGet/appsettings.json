{
  "ApiKey": "",

  // The file the server's Settings page saves to, loaded after appsettings*.json and before
  // environment variables and the command line. Empty means "appsettings.Overrides.json" in the
  // content root (or BAGET_CONFIG_ROOT). In a container, point it into a mounted volume.
  "SettingsOverridesPath": "",

  // User accounts, package owners and per-user API keys. While on and "ApiKey" is empty, a
  // push must carry a user API key (created on /account/apikeys); a keyless push is refused.
  // Set "Enabled" to false to get the previous behaviour of the global "ApiKey" alone.
  "Accounts": {
    "Enabled": true,
    "AllowRegistration": true

    // Users promoted to administrator at start, separated by ";", only while no administrator
    // exists and only if the account already exists. See "baget account promote <user>" as well.
    // "InitialAdministrators": "",

    // With no users at all, startup creates "Admin" / "Admin1234!"; change that password at once.
    // "CreateDefaultAdministrator": true
  },

  // Operator-supplied legal pages: Markdown files (absolute, or relative to the content root)
  // served at /terms and /privacy. The footer links to each only while it is set; BaGet
  // ships no legal text.
  "Site": {
    "TermsOfUsePath": "",
    "PrivacyPolicyPath": ""
  },

  "PathBase": ".",

  // The host names BaGet serves, separated by semicolons, for example
  // "nuget.example.com;nuget.example.com:8080". A request with any other "Host" header is
  // rejected, which stops a forged host from deciding the URLs BaGet advertises. "*", the
  // default, allows any host.
  "AllowedHosts": "*",

  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,

  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=baget.db"
  },
  //"Database": {
  //  "Type": "SqlServer",
  //  "ConnectionString": "Server=localhost;Database=BaGet;Trusted_Connection=True;TrustServerCertificate=True"
  //},

  "Storage": {
    "Type": "FileSystem",
    "Path": ""
  },

  "Search": {
    "Type": "Database"
  },

  "Mirror": {
    "Enabled": false,

    // Uncomment this to use the NuGet v2 protocol
    //"Legacy": true,
    "PackageSource": "https://api.nuget.org/v3/index.json"
  },

  // Uncomment this to configure BaGet to listen to port 8080.
  // See: https://docs.microsoft.com/en-us/aspnet/core/fundamentals/servers/kestrel?view=aspnetcore-3.1#listenoptionsusehttps
  //"Kestrel": {
  //  "Endpoints": {
  //    "Http": {
  //      "Url": "http://localhost:8080"
  //    }
  //  }
  //},

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:6060"
      }
    }
  },

  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Default": "Warning"
      }
    }
  }
}
