<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageTags>NuGet</PackageTags>
    <Description>BaGet Extension's NuGet server implementation</Description>
    <RootNamespace>BaGet.Web</RootNamespace>
    <!-- The assembly is BaGet.Web.V3, but the static web assets keep their URL (/_content/BaGet.Web/...):
         the layout, embedding hosts (wwwroot/_content/BaGet.Web) and the package docs use it. -->
    <StaticWebAssetBasePath>_content/BaGet.Web</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8620</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.402">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaGet.Web.Application\BaGet.Web.Application.csproj" />
    <ProjectReference Include="..\BaGet.Core\BaGet.Core.csproj" />
    <ProjectReference Include="..\BaGet.Web.V2\BaGet.Web.V2.csproj" />
    <ProjectReference Include="..\BaGet.Catalog\BaGet.Catalog.csproj" />
    <ProjectReference Include="..\BaGet.Identity\BaGet.Identity.csproj" />
    <ProjectReference Include="..\BaGet.Validation\BaGet.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibMan's restore manifest is a development file. The host has one too, and publishing
         both to the same path fails with NETSDK1152. -->
    <Content Update="libman.json" CopyToPublishDirectory="Never" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BaGet.Tests" Key="$(BaGetPublicKey)" />
    <InternalsVisibleTo Include="BaGet.Web.Tests" Key="$(BaGetPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

</Project>
