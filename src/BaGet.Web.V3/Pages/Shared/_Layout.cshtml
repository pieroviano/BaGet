@* Forwarding stub: the layout moved to ~/Views/Shared/_Layout.cshtml so that Razor Pages and MVC views share it.
   This path stays for host views that still name it (non-breaking); BaGet's own views use the new one. The sections
   of the page using this layout are handed on. *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section SearchForm {
    @await RenderSectionAsync("SearchForm", required: false)
}
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
@RenderBody()
