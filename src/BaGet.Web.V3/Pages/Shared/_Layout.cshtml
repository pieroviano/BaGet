@* Forwarding stub: the layout lives in ~/Views/Shared/_Layout.cshtml so that Razor Pages and MVC views share it.
   Pages naming "_Layout" find this file first (Pages/Shared is searched before Views/Shared), and so do host views that
   name this path. The page's sections are rendered here, eagerly: a section body is executed only when the outer layout
   renders it, which is after Razor checks that this layout rendered every section of the page. *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var searchForm = IsSectionDefined("SearchForm") ? await RenderSectionAsync("SearchForm") : null;
    var scripts = IsSectionDefined("Scripts") ? await RenderSectionAsync("Scripts") : null;
}
@section SearchForm {
    @searchForm
}
@section Scripts {
    @scripts
}
@RenderBody()
