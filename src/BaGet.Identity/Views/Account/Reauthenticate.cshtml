@model BaGet.Identity.ViewModels.ReauthenticateViewModel
@{
    ViewData["Title"] = "Confirm it is you";
}

<div class="col-sm-6">
    <h1>Confirm it is you</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    <p><a href="@Url.Page("/Account/Settings")">Back to account settings</a></p>
</div>
