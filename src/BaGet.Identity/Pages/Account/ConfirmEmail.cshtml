@page
@model BaGet.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="col-sm-6">
    <h1>Confirm email</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Succeeded)
    {
        <div class="alert alert-success" role="alert">
            @(Model.EmailChanged ? "Your email address has been changed." : "Thank you, your email address is confirmed.")
        </div>
        <p><a asp-page="/Account/Login">Sign in</a></p>
    }
    else
    {
        <div class="alert alert-danger" role="alert">This link is invalid, expired or already used.</div>
    }
</div>
