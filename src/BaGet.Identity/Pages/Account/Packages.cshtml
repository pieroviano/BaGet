@page
@model BaGet.Identity.Pages.Account.PackagesModel
@{
    ViewData["Title"] = "My packages";
}

<div class="col-sm-12">
    <h1>My packages</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Packages.Count == 0)
    {
        <p id="my-packages-empty">
            You do not own any package yet. <a asp-page="/Upload">Upload one</a>, or push with
            <code>dotnet nuget push</code> - the ID you push first becomes yours.
        </p>
    }
    else
    {
        <table class="table" id="my-packages">
            <thead>
                <tr><th>Package</th><th>Latest version</th><th>Versions</th><th>Downloads</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var package in Model.Packages)
                {
                    <tr>
                        <td><a href="~/packages/@package.Id">@package.Id</a></td>
                        <td>
                            @if (package.LatestVersion == null)
                            {
                                <text>None</text>
                            }
                            else
                            {
                                <a href="~/packages/@package.Id/@package.LatestVersion">@package.LatestVersion</a>
                                @(package.LatestVersionIsListed ? "" : " (unlisted)")
                            }
                        </td>
                        <td>@package.VersionCount</td>
                        <td>@package.Downloads.ToString("N0")</td>
                        <td>
                            <a href="~/packages/@package.Id/manage">Manage</a> ·
                            <a asp-page="/Upload" asp-route-id="@package.Id">Upload new version</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
