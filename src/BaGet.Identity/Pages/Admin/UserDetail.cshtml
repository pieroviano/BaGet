@page "/admin/users/{name}"
@model BaGet.Identity.Pages.Admin.UserDetailModel
@{
    ViewData["Title"] = Model.Account?.UserName ?? "User";
    var userUrl = Url.Content("~/admin/users/" + Uri.EscapeDataString(Model.Account?.UserName ?? string.Empty));
}

<div class="col-sm-12">
    <h1>@Model.Account?.UserName</h1>
    <hr class="breadcrumb-divider" />

    <p><a asp-page="/Admin/Users">Back to users</a></p>

    @if (Model.Message != null)
    {
        <div class="alert alert-success" role="alert" id="user-message">@Model.Message</div>
    }
    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert" id="user-error">@Model.Error</div>
    }

    @* Each section is independent: add another by adding a block with its own user-section-* id. *@
    <section id="user-section-account">
        <h2>Account</h2>
        <table class="table">
            <tr><th>Email</th><td>@(Model.Account?.Email ?? "None")</td></tr>
            <tr><th>Created</th><td>@Model.Account?.Created.ToString("yyyy-MM-dd")</td></tr>
            <tr><th>Role</th><td>@(Model.Account?.IsAdministrator == true ? "Administrator" : "User")</td></tr>
            <tr><th>Packages</th><td>@Model.OwnedPackageIds owned (<a href="@(userUrl + "/packages")">list</a>)</td></tr>
        </table>
    </section>

    <section id="user-section-organizations">
        <h2>Organizations</h2>
        @if (Model.Organizations.Count == 0)
        {
            <p>@Model.Account?.UserName belongs to no organization.</p>
        }
        else
        {
            <ul>
                @foreach (var organization in Model.Organizations)
                {
                    <li><a href="@Url.Content("~/admin/organizations/" + Uri.EscapeDataString(organization.Name ?? string.Empty))">@organization.Name</a></li>
                }
            </ul>
        }
    </section>

    <section id="user-section-keys">
        <h2>API keys</h2>
        @if (Model.Keys.Count == 0)
        {
            <p>@Model.Account?.UserName has no API keys.</p>
        }
        else
        {
            <form method="post" id="keys-form">
                <table class="table" id="user-keys">
                    <thead>
                        <tr><th>Description</th><th>Scopes</th><th>Packages</th><th>Created</th><th>Expires</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var key in Model.Keys)
                        {
                            <tr>
                                <td>@key.Description</td>
                                <td>@string.Join(", ", key.Scopes ?? Array.Empty<string>())</td>
                                <td><code>@key.PackageGlobPattern</code></td>
                                <td>@key.Created.ToString("yyyy-MM-dd")</td>
                                <td>@(key.Expires?.ToString("yyyy-MM-dd") ?? "Never")</td>
                                <td><button type="submit" class="btn btn-danger btn-xs" asp-page-handler="RevokeKey" name="key" value="@key.Key">Revoke</button></td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.HasPassword)
                {
                    <div class="form-group">
                        <label for="adminPassword">Your password</label>
                        <input id="adminPassword" name="password" type="password" class="form-control" autocomplete="current-password" />
                        <span class="help-block">Revoking asks for your password again.</span>
                    </div>
                }
                else
                {
                    <partial name="~/Pages/Account/_Reauthenticate.cshtml" model="@(new BaGet.Identity.Pages.Account.ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, "/Admin/UserDetail"))" />
                }
            </form>
        }
    </section>
</div>
