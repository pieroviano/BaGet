@page "/admin/repositories/{name}"
@model BaGet.Identity.Pages.Admin.RepositoryEditModel
@{
    ViewData["Title"] = "Repository " + Model.Name;
}

<div class="col-sm-12">
    <h1>Repository @Model.Name</h1>
    <hr class="breadcrumb-divider" />

    <dl>
        <dt>Type</dt>
        <dd>@Model.Repository?.Format / @Model.Repository?.Kind</dd>
        <dt>Feed</dt>
        <dd>
            <code id="repository-feed">@Model.FeedUrl</code>
            <button type="button" class="btn btn-default btn-xs" id="copy-repository-feed"
                    onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('repository-feed').textContent)">
                Copy
            </button>
        </dd>
        <dt>Packages</dt>
        <dd>@Model.Repository?.PackageCount</dd>
    </dl>

    <form method="post">
        <div class="checkbox">
            <label>
                <input type="checkbox" name="anonymousRead" value="true" checked="@Model.AnonymousRead" />
                Anonymous read: requests without credentials may read this repository
            </label>
            <input type="hidden" name="anonymousRead" value="false" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-default" href="@Url.Page("/Admin/Repositories")">Cancel</a>
    </form>

    @if (Model.Access != null)
    {
        <section id="repository-section-access">
            <h2>Effective access</h2>
            @if (!Model.Access.ModelAvailable)
            {
                <p id="repository-access-unavailable">
                    The configured database has no access model: everyone reads and any caller with valid credentials writes, subject
                    to package ownership.
                </p>
            }
            else
            {
                <p class="help-block">
                    Who holds each action here, from the <a asp-page="/Admin/Permissions">permission targets</a> that match this
                    repository and its project's roles. Server administrators hold every action. Package ownership still applies inside
                    Deploy, Delete, Annotate and Manage. Anonymous read is <strong>@(Model.Access.AnonymousRead ? "on" : "off")</strong>@(Model.Access.AnonymousRead ? "" : ": Everyone's Read does not apply here").
                    @if (Model.Access.Project != null)
                    {
                        <text>Project: <a href="@Url.Page("/Admin/ProjectDetail", new { name = Model.Access.Project })">@Model.Access.Project</a>.</text>
                    }
                </p>
                <table class="table" id="repository-access">
                    <tbody>
                        @foreach (var action in BaGet.Identity.Pages.Admin.AccessPageModel.AllActions)
                        {
                            var who = Model.Access.Who(action);
                            <tr data-action="@action">
                                <th>@action</th>
                                <td>@(who.Count == 0 ? "nobody but administrators" : string.Join(", ", who))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>
