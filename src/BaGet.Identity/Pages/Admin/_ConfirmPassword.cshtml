@model BaGet.Identity.Pages.Admin.ConfirmPasswordView

@if (Model.HasPassword)
{
    <div class="form-group">
        <label for="@Model.Id">Your password</label>
        <input id="@Model.Id" name="password" type="password" class="form-control" autocomplete="current-password" />
    </div>
}
else
{
    <partial name="~/Pages/Account/_Reauthenticate.cshtml" model="@(new BaGet.Identity.Pages.Account.ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, Model.ReturnPage))" />
}
