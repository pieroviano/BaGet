@page "/admin/users"
@model BaGet.Identity.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="col-sm-12">
    <h1>Users</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Message != null)
    {
        <div class="alert alert-success" role="alert" id="users-message">@Model.Message</div>
    }
    @if (Model.GeneratedPassword != null)
    {
        <div class="alert alert-info" role="alert" id="generated-password-alert">
            <p>New password for <strong>@Model.GeneratedFor</strong>. It is shown once and is not stored: copy it now and pass it on securely.
                Their sessions have ended and two-factor sign-in is off.</p>
            <p>
                <code id="generated-password">@Model.GeneratedPassword</code>
                <button type="button" class="btn btn-default btn-xs" id="copy-generated-password"
                        onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('generated-password').textContent)">Copy</button>
            </p>
        </div>
    }
    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert" id="users-error">@Model.Error</div>
    }

    <form method="get" class="form-inline">
        <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Search user names" />
        <button type="submit" class="btn btn-default">Search</button>
    </form>

    <form method="post" id="users-form">
        <input type="hidden" name="q" value="@Model.Q" />
        <input type="hidden" name="p" value="@Model.PageNumber" />

        <table class="table">
            <thead>
                <tr><th></th><th>User</th><th>Email</th><th>Created</th><th>Role</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td><partial name="_Avatar" model="new BaGet.Core.AvatarModel(user.UserName, user.AvatarUrl, 24)" /></td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@user.Created.ToString("yyyy-MM-dd")</td>
                        <td>@if (user.IsAdministrator) { <span class="label label-info">Administrator</span> }</td>
                        <td>
                            @if (user.IsAdministrator)
                            {
                                <button type="submit" class="btn btn-default btn-xs" asp-page-handler="Demote" name="userName" value="@user.UserName">Demote</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-default btn-xs" asp-page-handler="Promote" name="userName" value="@user.UserName">Promote</button>
                            }
                            @if (Model.CanAct(user))
                            {
                                <a class="btn btn-default btn-xs" href="@Url.Content("~/admin/users/" + Uri.EscapeDataString(user.UserName) + "/packages")">Packages</a>
                                <span class="btn-group">
                                    <button type="button" class="btn btn-default btn-xs dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Reset password <span class="caret"></span></button>
                                    <ul class="dropdown-menu">
                                        <li><button type="submit" class="btn btn-link" asp-page-handler="ResetPassword" name="userName" value="@user.UserName">Generate a password</button></li>
                                        @if (Model.CanEmailResetLink && !string.IsNullOrEmpty(user.Email))
                                        {
                                            <li><button type="submit" class="btn btn-link" asp-page-handler="SendResetLink" name="userName" value="@user.UserName">Email a reset link</button></li>
                                        }
                                    </ul>
                                </span>
                                <a class="btn btn-danger btn-xs" href="@Url.Content("~/admin/users/" + Uri.EscapeDataString(user.UserName) + "/delete")">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Users.Count == 0)
        {
            <p>No users match.</p>
        }

        <h2>Confirm</h2>
        <p>Every action here asks for your password again.</p>
        @if (Model.HasPassword)
        {
            <div class="form-group">
                <label for="adminPassword">Your password</label>
                <input id="adminPassword" name="password" type="password" class="form-control" autocomplete="current-password" />
            </div>
        }
        else
        {
            <partial name="~/Pages/Account/_Reauthenticate.cshtml" model="@(new BaGet.Identity.Pages.Account.ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, "/Admin/Users"))" />
        }
    </form>

    @if (Model.PageCount > 1)
    {
        <ul class="pager">
            @if (Model.PageNumber > 1)
            {
                <li class="previous"><a asp-page="/Admin/Users" asp-route-q="@Model.Q" asp-route-p="@(Model.PageNumber - 1)">Previous</a></li>
            }
            <li>Page @Model.PageNumber of @Model.PageCount</li>
            @if (Model.PageNumber < Model.PageCount)
            {
                <li class="next"><a asp-page="/Admin/Users" asp-route-q="@Model.Q" asp-route-p="@(Model.PageNumber + 1)">Next</a></li>
            }
        </ul>
    }
</div>
