@page "/packages/{id}/manage"
@model BaGet.Identity.Pages.Packages.ManageModel
@{
    ViewData["Title"] = $"Manage {Model.Id}";
}

<div class="col-sm-12">
    <h1>Manage @Model.Id</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Message != null)
    {
        <div class="alert alert-info" role="alert" id="manage-message">@Model.Message</div>
    }

    @if (Model.ActingAsAdministrator)
    {
        <div class="alert alert-warning" role="alert" id="manage-as-administrator">
            You are managing this package as an administrator.
        </div>
    }

    @if (Model.IsReadOnlyMode)
    {
        @* The buttons stay on the page but do nothing: every handler here is refused while
           the server is read-only, exactly as the push and metadata endpoints are. *@
        <div class="alert alert-warning" role="alert" id="manage-read-only">
            This server is in read-only mode. Nothing on this page can be changed - owners,
            listing, deprecation and deletion are all refused - until that is turned off.
        </div>
    }

    <h2>Owners</h2>
    <table class="table">
        <tbody>
            @foreach (var owner in Model.Owners)
            {
                <tr>
                    <td><a href="~/profiles/@owner.OwnerName">@owner.OwnerName</a>@(owner.IsVerified ? " (verified)" : "")</td>
                    <td>
                        <form method="post" asp-page-handler="RemoveOwner">
                            <input type="hidden" name="ownerName" value="@owner.OwnerName" />
                            <button type="submit" class="btn btn-default btn-xs" disabled="@Model.IsReadOnlyMode">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <form method="post" asp-page-handler="AddOwner" class="form-inline">
        <input type="text" name="ownerName" class="form-control" placeholder="User or organization" />
        <button type="submit" class="btn btn-primary" disabled="@Model.IsReadOnlyMode">Add owner</button>
    </form>

    <h2>Versions</h2>
    <p id="manage-upload">
        <a asp-page="/Upload" asp-route-id="@Model.Id">Upload new version</a>
    </p>
    <p class="help-block" id="manage-delete-caption">
        @Model.DeleteLabel: @Model.DeleteCaption
        @if (!Model.DeletionIsPermanent)
        {
            <text>It is the same operation as the Unlist button beside each version.</text>
        }
    </p>
    <table class="table">
        <thead><tr><th>Version</th><th>Downloads</th><th>Listed</th><th>Deprecation</th><th></th><th></th></tr></thead>
        <tbody>
            @foreach (var package in Model.Versions)
            {
                var version = package.NormalizedVersionString;
                <tr>
                    <td><a href="~/packages/@Model.Id/@version">@version</a></td>
                    <td>@package.Downloads.ToString("N0")</td>
                    <td>
                        @(package.Listed ? "Yes" : "No")
                        <form method="post" asp-page-handler="@(package.Listed ? "Unlist" : "Relist")" style="display:inline">
                            <input type="hidden" name="version" value="@version" />
                            <button type="submit" class="btn btn-default btn-xs" disabled="@Model.IsReadOnlyMode">@(package.Listed ? "Unlist" : "Relist")</button>
                        </form>
                    </td>
                    <td>
                        @if (package.Deprecation != null)
                        {
                            @string.Join(", ", package.Deprecation.Reasons ?? Array.Empty<string>())
                            <form method="post" asp-page-handler="Undeprecate" style="display:inline">
                                <input type="hidden" name="version" value="@version" />
                                <button type="submit" class="btn btn-default btn-xs" disabled="@Model.IsReadOnlyMode">Remove</button>
                            </form>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Deprecate" class="form-inline">
                            <input type="hidden" name="version" value="@version" />
                            @foreach (var reason in PackageDeprecation.KnownReasons)
                            {
                                <label><input type="checkbox" name="reasons" value="@reason" /> @reason</label>
                            }
                            <input type="text" name="message" class="form-control input-sm" placeholder="Message" />
                            <input type="text" name="alternatePackageId" class="form-control input-sm" placeholder="Alternate package" />
                            <button type="submit" class="btn btn-warning btn-xs" disabled="@Model.IsReadOnlyMode">Deprecate</button>
                        </form>
                    </td>
                    <td>
                        @* Labelled from the configured behaviour: on a server that unlists,
                           this button must not claim to delete. *@
                        <form method="post" asp-page-handler="Delete" style="display:inline">
                            <input type="hidden" name="version" value="@version" />
                            <button type="submit"
                                    class="@(Model.DeletionIsPermanent ? "btn btn-danger btn-xs" : "btn btn-default btn-xs")"
                                    onclick="return confirm('@Model.DeleteLabel @version? @Model.DeleteCaption')"
                                    disabled="@Model.IsReadOnlyMode">
                                @Model.DeleteLabel
                            </button>
                        </form>
                        @if (Model.IsAdministrator && !Model.DeletionIsPermanent)
                        {
                            @* The server only unlists; an administrator may still remove the version.
                               The password is in the danger zone's form, which this button submits. *@
                            <button type="submit" form="hard-delete-form" asp-page-handler="HardDelete"
                                    name="version" value="@version" class="btn btn-danger btn-xs"
                                    onclick="return confirm('Delete @version permanently? This cannot be undone. Enter your password in the Danger zone below first.')"
                                    disabled="@Model.IsReadOnlyMode">
                                Delete permanently
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Abuse reports</h2>
    @if (Model.Reports.Count == 0)
    {
        <p>There are no open reports.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Version</th><th>Reason</th><th>Details</th><th>Reporter</th><th></th></tr></thead>
            <tbody>
                @foreach (var report in Model.Reports)
                {
                    <tr>
                        <td>@report.PackageVersion</td>
                        <td>@report.Reason</td>
                        <td>@report.Details</td>
                        <td>@report.ReporterEmail</td>
                        <td>
                            <form method="post" asp-page-handler="ResolveReport">
                                <input type="hidden" name="key" value="@report.Key" />
                                <button type="submit" class="btn btn-default btn-xs" disabled="@Model.IsReadOnlyMode">Resolve</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.IsAdministrator)
    {
        <div class="panel panel-danger" id="danger-zone">
            <div class="panel-heading"><h3 class="panel-title">Danger zone</h3></div>
            <div class="panel-body">
                <p>
                    Deleting permanently removes the database rows and the files from storage, whatever
                    the server's deletion setting says. It cannot be undone. Deleting every version also
                    removes the owners, so the ID can be claimed again.
                </p>
                <form method="post" id="hard-delete-form">
                    @if (Model.HasPassword)
                    {
                        <div class="form-group">
                            <label for="hardDeletePassword">Your password</label>
                            <input id="hardDeletePassword" name="password" type="password" class="form-control" autocomplete="current-password" />
                        </div>
                    }
                    else
                    {
                        <partial name="~/Pages/Account/_Reauthenticate.cshtml" model="@(new BaGet.Identity.Pages.Account.ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, Url.Page("/Packages/Manage", new { id = Model.Id })))" />
                    }
                    <button type="submit" asp-page-handler="HardDeleteAll" class="btn btn-danger"
                            onclick="return confirm('Delete every version of @Model.Id permanently? This cannot be undone.')"
                            disabled="@Model.IsReadOnlyMode">
                        Delete all versions permanently
                    </button>
                </form>
            </div>
        </div>
    }
</div>
